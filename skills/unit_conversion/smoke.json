    "unit_a",
    "unit_b"
   ],
   "variants": [
    {
     "unit_a": "  km/h ",
     "unit_b": "m/s"
    },
    {
     "unit_a": "km/h",
     "unit_b": "  m/s "
    }
   ]
  },
  "convert_to_base_si_units": {
   "args": {
    "value": 1,
