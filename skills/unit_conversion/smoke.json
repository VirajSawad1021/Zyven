    "converted_value",
    "from_unit",
    "to_unit",
    "dimensionality",
    "display"
   ],
   "required": [
    "value",
    "from_unit",
    "to_unit"
   ],
   "variants": [
    {
     "value": 100,
     "from_unit": "  degC ",
     "to_unit": "degF"
    },
    {
     "value": 100,
     "from_unit": "degC",
     "to_unit": "  degF "
    }
   ]
  },
  "check_unit_compatibility": {
