# Zyven model provider config.
# Any OpenAI-compatible chat endpoint serving an OPEN-WEIGHT model.
# Proprietary models (GPT, Claude, Gemini) are NOT allowed by Frogtoberfest rules.
# Copy this file to .env and fill in MODEL_API_KEY. Never commit .env.

# --- Option A: Google AI Studio serving Gemma (open-weight) -----------------
# Use a Gemma model id only (check the current list in AI Studio), never a gemini-* id.
MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_NAME=gemma-4-26b-a4b-it
MODEL_API_KEY=

# --- Option B: Groq (Qwen / Llama) ------------------------------------------
# MODEL_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=<qwen-or-llama-model-id>
# MODEL_API_KEY=

# --- Option C: OpenRouter (many open-weight models) -------------------------
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=qwen/<model-id>
# MODEL_API_KEY=

# --- Option D: Local Ollama (T4 or laptop) ----------------------------------
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=<qwen-model-tag>
# MODEL_API_KEY=ollama

# Embeddings (must also be open-weight)
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=

# Generation defaults
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=120

# --- Optional backup host: used automatically when the primary host fails ---------------
# Must serve an open-weight model; ideally the same model as MODEL_NAME for consistent behaviour.
FALLBACK_MODEL_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_MODEL_NAME=google/gemma-4-26b-a4b-it:free
FALLBACK_MODEL_API_KEY=
